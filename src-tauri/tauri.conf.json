{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SiliconRunner",
  "version": "1.0.1",
  "identifier": "com.stefan.siliconrunner",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SiliconRunner",
        "width": 1200,
        "height": 800,
        "minWidth": 1200,
        "minHeight": 800,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
